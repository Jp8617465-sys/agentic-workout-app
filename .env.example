# Supabase — Gym-OS project (hmomveujugqdtvwqzyqp, ap-southeast-1)
EXPO_PUBLIC_SUPABASE_URL=https://hmomveujugqdtvwqzyqp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic API Key — set as Supabase Edge Function secret, NOT here:
# supabase secrets set ANTHROPIC_API_KEY=your-key

# JAMES-OS Edge Function also requires (service role key stays server-side only):
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (Get from Supabase dashboard > Settings > API > service_role)

# KB upload script — run once to populate james-os-kb Storage bucket:
# SUPABASE_URL=https://hmomveujugqdtvwqzyqp.supabase.co \
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key \
# npx ts-node --project tsconfig.node.json scripts/upload-kb-to-storage.ts
