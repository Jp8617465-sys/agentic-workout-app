{
  "name": "intelligent-trainer",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "tsc": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:unit:ci": "jest --config jest.unit.config.js --ci --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@legendapp/state": "^2.1.15",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@shopify/flash-list": "~1.7.3",
    "@supabase/supabase-js": "^2.98.0",
    "drizzle-orm": "~0.40.0",
    "expo": "~55.0.4",
    "expo-haptics": "~14.1.3",
    "expo-notifications": "~0.32.6",
    "expo-secure-store": "^55.0.8",
    "expo-sqlite": "~15.1.2",
    "expo-status-bar": "~55.0.4",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "~15.11.2",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.17",
    "drizzle-kit": "~0.30.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.0",
    "prettier": "^3.2.0",
    "tailwindcss": "~3.4.17",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
